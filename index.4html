<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>El Bajón Deli | Kiosco Del</title>
<meta name="description" content="Combos de bebidas y hielo con delivery en Resistencia, Barranqueras, Puerto Vilelas y Fontana. Armá tu pedido online.">
<meta name="theme-color" content="#080808">
<meta property="og:title" content="El Bajón Deli | Kiosco Del">
<meta property="og:description" content="Combos y hielo con delivery en el Gran Resistencia. Vos pedí, nosotros llevamos.">
<meta property="og:type" content="website">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ctext y='.9em' font-size='90'%3E🌙%3C/text%3E%3C/svg%3E">
<style>
:root{
  --bg:#080808;--panel:#111;--panel2:#181818;--line:#2a2a2a;
  --text:#f5f5f5;--muted:#a8a8a8;--red:#ff3030;--ink:#11140d;
  --radius:18px;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{
  margin:0;color:var(--text);font-family:system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;
  background-color:var(--bg);
  background-image:linear-gradient(rgba(255,48,48,.025) 1px,transparent 1px),linear-gradient(90deg,rgba(255,48,48,.025) 1px,transparent 1px);
  background-size:28px 28px;
  -webkit-tap-highlight-color:transparent;
}
button,input,select,textarea{font:inherit}
button{cursor:pointer;border:0}
:focus-visible{outline:2px solid var(--red);outline-offset:2px}
.muted,small{color:var(--muted)}
.wrap{max-width:1100px;margin:auto;padding:0 18px}
[hidden]{display:none!important}

/* Header */
.top{position:sticky;top:0;z-index:3;background:rgba(8,8,8,.92);backdrop-filter:blur(8px);border-bottom:1px solid var(--line)}
.nav{height:70px;display:flex;justify-content:space-between;align-items:center;gap:12px}
.logo{font-size:23px;font-weight:900;letter-spacing:-1px;line-height:1}
.logo span{color:var(--red)}
.tagline{display:block;font-size:9px;letter-spacing:2px;margin-top:4px}
.btn{background:var(--red);color:var(--ink);padding:12px 16px;border-radius:12px;font-weight:850;transition:box-shadow .2s,transform .1s}
.btn:hover{box-shadow:0 0 18px rgba(255,48,48,.3)}
.btn:active{transform:scale(.98)}
.btn:disabled{opacity:.5;cursor:not-allowed;box-shadow:none}
.btn.ghost{background:transparent;color:var(--text);border:1px solid var(--line)}
.btn.wa{background:#25d366;color:#06240f;display:inline-block;text-decoration:none;text-align:center}
.pill{display:inline-block;min-width:22px;padding:1px 7px;margin-left:6px;border-radius:99px;background:var(--ink);color:var(--red);font-size:13px;text-align:center}

/* Hero */
.hero{display:grid;grid-template-columns:1.2fr .8fr;gap:15px;padding:28px 0 14px}
.hero>div{border-radius:24px;padding:clamp(24px,5vw,48px);border:1px solid var(--line);background:radial-gradient(circle at 90% 10%,rgba(255,48,48,.16),transparent 45%),var(--panel)}
.hero .side{background:var(--red);color:var(--ink);display:flex;flex-direction:column;justify-content:center;border-color:var(--red)}
.eyebrow{font-size:11px;letter-spacing:2px;color:var(--red);font-weight:900}
.side .eyebrow{color:rgba(17,20,13,.7)}
.hero h1{font-size:clamp(40px,6vw,64px);line-height:.98;letter-spacing:-3px;margin:13px 0}
.hero h1 em{font-style:normal;color:var(--red)}
.hero p{line-height:1.5;color:var(--muted)}
.side h2{font-size:30px;margin:12px 0;line-height:1.1}
.side p{color:rgba(17,20,13,.75);margin:0 0 12px}

/* Info */
.info{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin:0 0 18px}
.info div{background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:12px 14px;font-size:13px;line-height:1.4}
.info b{display:block;font-size:14px}
.notice{background:#1d1313;border:1px solid rgba(255,48,48,.3);color:#f2c9c9;padding:12px;border-radius:12px;font-size:12px;line-height:1.5;margin-bottom:18px}
.notice p{margin:6px 0 0}

/* Catálogo */
.search{width:100%;background:var(--panel);border:1px solid var(--line);color:var(--text);padding:14px;border-radius:13px;margin-bottom:12px}
.search:focus{border-color:var(--red);outline:none}
.filters{display:flex;gap:8px;overflow:auto;padding:0 0 18px;scrollbar-width:none}
.filters::-webkit-scrollbar{display:none}
.filter{white-space:nowrap;background:var(--panel);border:1px solid var(--line);color:var(--muted);border-radius:99px;padding:10px 14px}
.filter.active{background:var(--red);color:var(--ink);border-color:var(--red);font-weight:800}
.head{display:flex;justify-content:space-between;align-items:center;margin-bottom:6px}
.head h2{font-size:26px;letter-spacing:-1px;margin:10px 0}
.grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:13px;padding-bottom:50px}
.product{border:1px solid var(--line);background:var(--panel);border-radius:var(--radius);overflow:hidden;display:flex;flex-direction:column;transition:border-color .2s,transform .2s}
.product:hover{border-color:rgba(255,48,48,.45);transform:translateY(-2px)}
.art{height:150px;background:radial-gradient(circle at 50% 20%,#2a2a2a,#151515 72%);display:grid;place-items:center;font-size:65px;position:relative}
.tag{position:absolute;top:9px;left:9px;background:rgba(8,8,8,.9);color:var(--red);font-size:10px;padding:6px 8px;border-radius:7px}
.details{padding:13px;display:flex;flex-direction:column;flex:1}
.cat{font-size:10px;letter-spacing:1px;text-transform:uppercase;color:var(--muted)}
.details h3{font-size:15px;margin:7px 0;line-height:1.25}
.desc{font-size:12px;color:var(--muted);margin:0 0 13px;flex:1}
.buy{display:flex;align-items:center;justify-content:space-between;gap:7px}
.price{font-weight:900;color:var(--red)}
.add{background:var(--red);color:var(--ink);width:40px;height:40px;border-radius:10px;font-size:22px;font-weight:700}
.ask{color:var(--text);font-size:12px;font-weight:800;border:1px solid var(--red);border-radius:10px;padding:9px 11px;text-decoration:none}
.empty{grid-column:1/-1;text-align:center;padding:40px;color:var(--muted)}
.footer{border-top:1px solid var(--line);padding:24px 0 110px;color:var(--muted);font-size:12px;line-height:1.7}

/* Barra de carrito */
.cartbar{position:fixed;left:50%;bottom:14px;transform:translateX(-50%);z-index:5;width:min(560px,calc(100% - 26px));display:flex;justify-content:space-between;align-items:center;background:var(--red);color:var(--ink);border-radius:16px;padding:14px 18px;font-weight:900;box-shadow:0 8px 30px rgba(0,0,0,.6)}

/* Carrito */
.overlay,.modal{display:none;position:fixed;inset:0;background:rgba(0,0,0,.7);z-index:10}
.overlay.show{display:block}
.drawer{position:absolute;right:0;top:0;height:100%;width:min(430px,100%);background:#121212;padding:22px;display:flex;flex-direction:column;overflow:auto;border-left:1px solid var(--line)}
.drawhead{display:flex;justify-content:space-between;align-items:center}
.drawhead h2{margin:0}
.close{background:#262626;color:var(--text);border-radius:9px;width:40px;height:40px;font-size:22px}
.items{flex:1;padding:12px 0}
.item{display:grid;grid-template-columns:38px 1fr auto;gap:10px;padding:13px 0;border-bottom:1px solid var(--line);align-items:center}
.item h4{font-size:14px;margin:0 0 4px}
.qty{display:flex;align-items:center;gap:10px;margin-top:7px}
.qty button{background:#262626;color:var(--text);border-radius:8px;width:30px;height:30px}
.rowtotal{display:flex;justify-content:space-between;padding:8px 0;color:var(--muted);gap:10px}
.rowtotal.total{font-size:20px;color:var(--text);font-weight:900;border-top:1px solid var(--line);padding-top:14px}
.checkout{width:100%;margin-top:10px;padding:14px}
.tiny{font-size:11px;color:var(--muted);line-height:1.5}

/* Formulario */
.modal{z-index:15;padding:15px;overflow:auto;align-items:center;justify-content:center}
.modal.show{display:flex}
.box{width:min(500px,100%);background:#141414;border:1px solid var(--line);border-radius:20px;padding:23px;max-height:95vh;overflow:auto}
.field{display:flex;flex-direction:column;gap:6px;margin:12px 0}
.field label{font-size:12px;color:var(--muted)}
.field input,.field select,.field textarea{background:#1f1f1f;border:1px solid var(--line);border-radius:10px;padding:12px;color:var(--text);width:100%}
.field input:focus,.field select:focus,.field textarea:focus{border-color:var(--red);outline:none}
.two{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.transfer{background:#161616;border:1px dashed rgba(255,48,48,.5);border-radius:12px;padding:12px;font-size:13px;line-height:1.6;margin:4px 0 12px}
.transfer .row{display:flex;justify-content:space-between;align-items:center;gap:10px}
.transfer .copy{background:#262626;color:var(--text);border-radius:8px;padding:6px 10px;font-size:12px}
.ordersum{background:#161616;border:1px solid var(--line);border-radius:12px;padding:6px 12px;margin:12px 0}
.formerror{color:#ff8a8a;font-size:13px;margin:8px 0 0;min-height:1em}
.confirmation{display:none;text-align:center}
.confirmation.show{display:block}
.confirmation .notice{text-align:left}
.stack{display:grid;gap:10px;margin-top:12px}

.toast{display:none;position:fixed;bottom:84px;left:50%;transform:translateX(-50%);background:#fff;color:#111;padding:11px 16px;border-radius:10px;font-weight:800;z-index:30;max-width:calc(100% - 30px);text-align:center}
.toast.show{display:block}

@media(max-width:980px){.grid{grid-template-columns:repeat(3,minmax(0,1fr))}}
@media(max-width:760px){
  .wrap{padding:0 13px}
  .hero{grid-template-columns:1fr;padding-top:18px;gap:10px}
  .hero>div{padding:27px}
  .hero h1{font-size:49px}
  .info{grid-template-columns:1fr}
  .head h2{font-size:23px}
  .two{grid-template-columns:1fr}
}
@media(max-width:640px){
  .grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}
  .art{height:115px;font-size:52px}
  .details{padding:10px}
  .price{font-size:14px}
  .desc{font-size:11px}
}
/* ============ CAPA 3D / TECH ============ */
:root{--mono:ui-monospace,SFMono-Regular,Menlo,Consolas,"Liberation Mono",monospace}

/* Piso en perspectiva (grilla que avanza) */
.bg3d{position:fixed;left:0;right:0;bottom:0;height:60vh;z-index:-1;pointer-events:none;perspective:520px;overflow:hidden;-webkit-mask-image:linear-gradient(to top,#000 10%,transparent);mask-image:linear-gradient(to top,#000 10%,transparent)}
.bg3d::before{content:"";position:absolute;left:-60%;right:-60%;top:0;bottom:-120%;background-image:linear-gradient(rgba(255,48,48,.35) 1px,transparent 1px),linear-gradient(90deg,rgba(255,48,48,.35) 1px,transparent 1px);background-size:64px 64px;transform:rotateX(64deg);transform-origin:top center;animation:floor 5s linear infinite}
@keyframes floor{to{background-position:0 64px}}

.btn{white-space:nowrap}
@media(max-width:480px){.tagline{font-size:8px;letter-spacing:1px}.nav .btn{padding:11px 13px}.logo{font-size:21px}}

/* Tipografía tech */
.eyebrow,.cat,.tag,.tagline,.pill,.price,.filter,.info b{font-family:var(--mono)}
.logo{text-shadow:0 0 22px rgba(255,48,48,.25)}
.hero h1 em{text-shadow:0 0 28px rgba(255,48,48,.6)}
.price{text-shadow:0 0 14px rgba(255,48,48,.45)}
.top{border-bottom-color:rgba(255,48,48,.35);box-shadow:0 1px 22px rgba(255,48,48,.12)}

/* Botones con relieve */
.btn,.add{box-shadow:0 4px 0 #9e1616}
.btn:hover,.add:hover{box-shadow:0 4px 0 #9e1616,0 0 22px rgba(255,48,48,.45)}
.btn:active,.add:active{transform:translateY(3px);box-shadow:0 1px 0 #9e1616}
.btn.wa{box-shadow:0 4px 0 #168a45}
.btn.wa:hover{box-shadow:0 4px 0 #168a45,0 0 22px rgba(37,211,102,.4)}
.btn:disabled{box-shadow:none}
.cartbar{box-shadow:0 5px 0 #9e1616,0 12px 40px rgba(255,48,48,.35)}

/* Tarjetas del hero: inclinación 3D */
.hero>div{transform:perspective(900px) rotateX(var(--rx,0deg)) rotateY(var(--ry,0deg));transition:transform .25s ease-out;will-change:transform}
.hero>div.tilting{transition:transform .06s linear}

/* Cubo giratorio */
.scene{perspective:700px;height:150px;display:grid;place-items:center;margin-top:8px}
.cube{width:96px;height:96px;position:relative;transform-style:preserve-3d;animation:spin 18s linear infinite}
.cube .face{position:absolute;inset:0;display:grid;place-items:center;font-size:42px;background:rgba(17,20,13,.9);border:2px solid rgba(255,255,255,.18);border-radius:14px;box-shadow:inset 0 0 22px rgba(255,48,48,.35)}
.cube .f1{transform:translateZ(48px)}
.cube .f2{transform:rotateY(90deg) translateZ(48px)}
.cube .f3{transform:rotateY(180deg) translateZ(48px)}
.cube .f4{transform:rotateY(-90deg) translateZ(48px)}
.cube .f5{transform:rotateX(90deg) translateZ(48px)}
.cube .f6{transform:rotateX(-90deg) translateZ(48px)}
.cube .face.photo{background:#fff;padding:5px;border-color:rgba(255,255,255,.5);box-shadow:0 0 18px rgba(255,48,48,.35)}
.cube .face.photo img{width:100%;height:100%;object-fit:contain;display:block;border-radius:8px}
@keyframes spin{from{transform:rotateX(-24deg) rotateY(0)}to{transform:rotateX(-24deg) rotateY(360deg)}}

/* Productos: tilt, brillo y parallax */
.product{position:relative;transform:perspective(800px) rotateX(var(--rx,0deg)) rotateY(var(--ry,0deg));transition:transform .14s ease-out,border-color .2s,box-shadow .2s;will-change:transform}
.product:hover{transform:perspective(800px) rotateX(var(--rx,0deg)) rotateY(var(--ry,0deg)) translateZ(8px);border-color:rgba(255,48,48,.6);box-shadow:0 18px 40px rgba(0,0,0,.6),0 0 30px rgba(255,48,48,.14)}
.product::after{content:"";position:absolute;inset:0;pointer-events:none;opacity:0;transition:opacity .2s;background:radial-gradient(circle at var(--gx,50%) var(--gy,0%),rgba(255,255,255,.14),transparent 55%)}
.product.tilting::after{opacity:1}
.art{background:radial-gradient(circle at 50% 20%,rgba(255,48,48,.2),#151515 70%)}
.art .e{display:inline-block;filter:drop-shadow(0 10px 14px rgba(0,0,0,.6));transform:translate(calc(var(--px,0)*9px),calc(var(--py,0)*9px));transition:transform .14s ease-out;animation:float 3.4s ease-in-out infinite}
.product:nth-child(even) .art .e{animation-delay:-1.4s}
@keyframes float{0%,100%{translate:0 0}50%{translate:0 -7px}}

/* Paneles de vidrio con entrada 3D */
.drawer{background:rgba(18,18,18,.88);backdrop-filter:blur(14px)}
.box{background:rgba(20,20,20,.92);backdrop-filter:blur(14px);box-shadow:0 0 0 1px rgba(255,48,48,.18),0 30px 80px rgba(0,0,0,.7)}
.overlay.show .drawer{animation:slideIn .35s cubic-bezier(.2,.8,.2,1)}
.modal.show .box{animation:popIn .35s cubic-bezier(.2,.8,.2,1)}
@keyframes slideIn{from{transform:perspective(900px) translateX(60px) rotateY(-14deg);opacity:0}}
@keyframes popIn{from{transform:perspective(900px) translateY(26px) rotateX(14deg) scale(.95);opacity:0}}

@media(max-width:640px){.scene{height:130px}.cube{width:84px;height:84px}.cube .face{font-size:36px}.cube .f1{transform:translateZ(42px)}.cube .f2{transform:rotateY(90deg) translateZ(42px)}.cube .f3{transform:rotateY(180deg) translateZ(42px)}.cube .f4{transform:rotateY(-90deg) translateZ(42px)}.cube .f5{transform:rotateX(90deg) translateZ(42px)}.cube .f6{transform:rotateX(-90deg) translateZ(42px)}}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*{transition:none!important}.cube,.bg3d::before,.art .e,.overlay.show .drawer,.modal.show .box{animation:none!important}.cube{transform:rotateX(-24deg) rotateY(-30deg)}}
</style>
</head>
<body>
<div class="bg3d" aria-hidden="true"></div>

<header class="top">
  <div class="wrap nav">
    <div>
      <div class="logo">EL BAJÓN <span>DELI.</span></div>
      <small class="tagline">KIOSCO DEL · EL BAJÓN A TU PUERTA</small>
    </div>
    <button class="btn" id="open" aria-label="Abrir mi pedido">Mi pedido <span class="pill" id="count">0</span></button>
  </div>
</header>

<main class="wrap">
  <section class="hero">
    <div>
      <div class="eyebrow">PARA ESAS GANAS DE ALGO RICO</div>
      <h1>¿PEGÓ EL<br><em>BAJÓN?</em></h1>
      <p>Combos de bebidas y hielo para salvarte la noche. Elegí tus favoritos y armá tu pedido en un minuto.</p>
      <button class="btn" id="seeProducts">Ver productos ↓</button>
    </div>
    <div class="side">
      <div class="eyebrow">KIOSCO DELIVERY</div>
      <h2>Vos pedí.<br>Nosotros llevamos. 🌙</h2>
      <p>Resistencia · Barranqueras · Puerto Vilelas · Fontana</p>
      <div class="scene" aria-hidden="true">
        <div class="cube">
          <span class="face photo f1"><img src="data:image/jpeg;base64," alt="Absolut Raspberri" width="256" height="256"></span>
          <span class="face photo f2"><img src="data:image/jpeg;base64," alt="Vino Dilema y Speed" width="256" height="256"></span>
          <span class="face photo f3"><img src="data:image/jpeg;base64," alt="Fernet y Coca-Cola" width="256" height="256"></span>
          <span class="face photo f4"><img src="data:image/jpeg;base64," alt="Skyy y Monster" width="256" height="256"></span>
          <span class="face photo f5"><img src="data:image/jpeg;base64," alt="Smirnoff y Speed" width="256" height="256"></span>
        </div>
      </div>
    </div>
  </section>

  <section class="info" aria-label="Información de envío y pago">
    <div><b>🛵 Delivery a domicilio</b><span class="muted" id="infoEnvio"></span></div>
    <div><b>💵 Pagás como quieras</b><span class="muted">Efectivo o transferencia</span></div>
    <div><b>🧊 Hielo y vaso</b><span class="muted">Algunos combos lo incluyen de regalo</span></div>
  </section>

  <div class="notice" id="demoNotice" hidden>🟢 <b>Los pagos no se procesan y las entregas aún no están habilitadas.</b> Productos y precios ilustrativos.</div>

  <section id="catalogo">
    <label for="search" class="muted" style="position:absolute;left:-9999px">Buscar productos</label>
    <input id="search" class="search" type="search" placeholder="🔎 Buscar combos, hielo, vodka, gin..." autocomplete="off">
    <div class="filters" id="filters" role="group" aria-label="Categorías"></div>
    <div class="head"><h2>¿Qué pinta para hoy?</h2><small id="countProducts"></small></div>
    <div class="grid" id="products"></div>
  </section>

  <footer class="footer">
    <b style="color:var(--red)">EL BAJÓN DELI.</b><br>
    Zona de entrega: Resistencia · Barranqueras · Puerto Vilelas · Fontana<br>
    Horario y cobertura sujetos a disponibilidad.<br>
    Venta de bebidas alcohólicas exclusiva para mayores de 18 años.
  </footer>
</main>

<button class="cartbar" id="cartbar" hidden aria-label="Ver mi pedido">
  <span><span id="barCount">0</span> productos</span>
  <span>Ver pedido · <span id="barTotal">$0</span></span>
</button>

<div class="overlay" id="overlay" aria-hidden="true">
  <aside class="drawer" role="dialog" aria-modal="true" aria-labelledby="drawTitle">
    <div class="drawhead"><h2 id="drawTitle">Tu pedido 🛍️</h2><button class="close" id="close" aria-label="Cerrar">×</button></div>
    <div id="items" class="items"></div>
    <div>
      <div class="rowtotal"><span>Subtotal</span><b id="subtotal">$0</b></div>
      <div class="rowtotal"><span>Envío</span><span id="envioRango"></span></div>
      <div class="rowtotal total"><span>Subtotal + envío</span><span id="total">$0</span></div>
      <button class="btn checkout" id="go">Continuar con el pedido</button>
      <p class="tiny" id="drawNote"></p>
    </div>
  </aside>
</div>

<div class="modal" id="modal" aria-hidden="true">
  <div class="box" role="dialog" aria-modal="true" aria-labelledby="formTitle">
    <div id="formwrap">
      <div class="drawhead"><h2 id="formTitle">Datos de entrega</h2><button class="close" id="closemodal" aria-label="Cerrar">×</button></div>
      <p class="tiny" id="formNote"></p>
      <form id="form" novalidate>
        <div class="field"><label for="name">Nombre y apellido</label><input id="name" required autocomplete="name" placeholder="Tu nombre"></div>
        <div class="field"><label for="phone">Teléfono</label><input id="phone" required type="tel" inputmode="tel" autocomplete="tel" placeholder="Ej: 362 4123456"></div>
        <div class="two">
          <div class="field"><label for="city">Localidad</label>
            <select id="city" required><option value="">Elegí tu zona</option></select></div>
          <div class="field"><label for="payment">Forma de pago</label>
            <select id="payment" required><option value="">Elegí</option><option>Efectivo</option><option>Transferencia</option></select></div>
        </div>
        <div class="transfer" id="transferInfo" hidden>
          <b>Datos para transferir</b>
          <div class="row"><span>Alias: <strong id="aliasTxt"></strong></span><button type="button" class="copy" id="copyAlias">Copiar</button></div>
          <div>Titular: <strong id="titularTxt"></strong></div>
          <div class="tiny">Una vez realizada la transferencia, conservá el comprobante para verificar el pago.</div>
        </div>
        <div class="field"><label for="address">Dirección</label><input id="address" required autocomplete="street-address" placeholder="Calle, número y barrio"></div>
        <div class="field"><label for="notes">Indicaciones (opcional)</label><textarea id="notes" rows="2" placeholder="Referencia para encontrar tu casa"></textarea></div>
        <div class="ordersum" id="ordersum"></div>
        <div class="notice" id="formNotice">No ingreses datos de tarjetas en este formulario.</div>
        <button class="btn checkout" id="submitBtn" type="submit">Confirmar pedido</button>
        <p class="formerror" id="formerror" role="alert"></p>
      </form>
    </div>
    <div id="confirmation" class="confirmation">
      <div style="font-size:45px">🧾</div>
      <h2 id="confTitle"></h2>
      <p id="confirmtext" class="tiny"></p>
      <div id="summary" class="notice"></div>
      <div class="stack">
        <a class="btn wa" id="waBtn" target="_blank" rel="noopener" hidden>Enviar por WhatsApp</a>
        <button class="btn checkout" id="finish" type="button">Volver a la tienda</button>
      </div>
      <p class="tiny" id="confNote"></p>
    </div>
  </div>
</div>

<div class="toast" id="toast" role="status" aria-live="polite"></div>

<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<script>
/* ============ CONFIGURACIÓN (lo que más vas a tocar) ============ */
const CONFIG = {
  // true = muestra los avisos de "demo". Pasalo a false cuando atiendas pedidos reales.
  MODO_DEMO: true,
  // Tu WhatsApp con código de país y sin signos. Ej: "5493624123456". Vacío = sin botón de WhatsApp.
  WHATSAPP: "",
  ALIAS: "elbajonndeli",
  TITULAR: "Morena Trinidad Allende",
  ENVIO: { "Resistencia": 2000, "Barranqueras": 2000, "Puerto Vilelas": 3000, "Fontana": 3000 },
  SUPABASE_URL: "https://hwaxsksynhfffchmdxeg.supabase.co",
  SUPABASE_KEY: "sb_publishable_NmzFzSajtat2a88Da5p5uQ_PdoxICDR"
};

/* Productos: [id, nombre, categoría, precio (null = consultar), emoji, descripción, etiqueta] */
const products = [
  [1, "Absolut Blue 500 cc + 2 Red Bull", "Combos", null, "🍸", "Combo con Absolut Blue y dos Red Bull", ""],
  [2, "Absolut sabor + 2 Monster", "Combos", null, "🍹", "Combo con Absolut sabor y dos Monster", ""],
  [3, "Gin Gordon's + Tónica", "Combos", null, "🍸", "Gin Gordon's acompañado de tónica", ""],
  [4, "Smirnoff + Cepita 1,5 L", "Combos", null, "🍹", "Incluye hielo de regalo", "Hielo de regalo"],
  [5, "Smirnoff sabor + Sprite 2,25 L", "Combos", null, "🍹", "Incluye hielo de regalo", "Hielo de regalo"],
  [6, "Vino blanco Dilema + 2 Speed", "Combos", null, "🍷", "Combo con vino blanco Dilema y dos Speed", ""],
  [7, "Skyy + Sprite 2,25 L", "Combos", null, "🍸", "Incluye vaso y hielo", "Vaso + hielo"],
  [8, "Skyy sabor + 3 Speed", "Combos", null, "🍹", "Combo con Skyy sabor y tres Speed", ""],
  [9, "Hielo 1,5 kg", "Hielo", 2500, "🧊", "Bolsa de hielo de 1,5 kg", ""],
  [10, "Hielo 5 kg", "Hielo", 5000, "🧊", "Bolsa de hielo de 5 kg", ""],
  [11, "Hielo 10 kg", "Hielo", 10000, "🧊", "Bolsa de hielo de 10 kg", ""]
].map(a => ({ id: a[0], name: a[1], cat: a[2], price: a[3], emoji: a[4], desc: a[5], tag: a[6] }));

/* ============ Utilidades ============ */
const $ = s => document.querySelector(s);
const cats = ["Todo", ...new Set(products.map(p => p.cat))];
const CART_KEY = "bajon_cart_v1";
const wa = String(CONFIG.WHATSAPP || "").replace(/\D/g, "");
let selected = "Todo";
let cart = loadCart();
let lastFocus = null;

const money = n => n.toLocaleString("es-AR", { style: "currency", currency: "ARS", maximumFractionDigits: 0 });
const byId = id => products.find(p => p.id === Number(id));

function loadCart() {
  try {
    const raw = JSON.parse(localStorage.getItem(CART_KEY) || "{}");
    const out = {};
    for (const [id, q] of Object.entries(raw)) {
      const p = byId(id);
      if (p && p.price !== null && Number.isInteger(q) && q > 0) out[id] = Math.min(q, 99);
    }
    return out;
  } catch (e) { return {}; }
}
function saveCart() { try { localStorage.setItem(CART_KEY, JSON.stringify(cart)); } catch (e) {} }

function totals() {
  const lines = Object.entries(cart).map(([id, q]) => ({ p: byId(id), q }));
  return { lines, n: lines.reduce((s, l) => s + l.q, 0), sub: lines.reduce((s, l) => s + l.p.price * l.q, 0) };
}
function waLink(text) { return `https://wa.me/${wa}?text=${encodeURIComponent(text)}`; }

let toastTimer;
function toast(msg) {
  const t = $("#toast");
  t.textContent = msg;
  t.classList.add("show");
  clearTimeout(toastTimer);
  toastTimer = setTimeout(() => t.classList.remove("show"), 1500);
}

/* ============ Catálogo ============ */
function renderFilters() {
  $("#filters").innerHTML = cats.map(c =>
    `<button type="button" class="filter ${selected === c ? "active" : ""}" data-cat="${c}" aria-pressed="${selected === c}">${c}</button>`
  ).join("");
}

function renderProducts() {
  const q = $("#search").value.toLowerCase().trim();
  const list = products.filter(p =>
    (selected === "Todo" || p.cat === selected) &&
    (p.name + " " + p.cat + " " + p.desc).toLowerCase().includes(q)
  );
  $("#countProducts").textContent = list.length + (list.length === 1 ? " producto" : " productos");

  $("#products").innerHTML = list.length ? list.map(p => {
    let action;
    if (p.price !== null) {
      action = `<span class="price">${money(p.price)}</span><button type="button" class="add" data-add="${p.id}" aria-label="Agregar ${p.name}">+</button>`;
    } else if (wa) {
      action = `<span class="price">Consultar</span><a class="ask" target="_blank" rel="noopener" href="${waLink("Hola! Quiero consultar el precio del combo: " + p.name)}">Preguntar</a>`;
    } else {
      action = `<span class="price">Consultar precio</span>`;
    }
    return `<article class="product">
      <div class="art" aria-hidden="true"><span class="e">${p.emoji}</span>${p.tag ? `<span class="tag">${p.tag}</span>` : ""}</div>
      <div class="details">
        <div class="cat">${p.cat}</div>
        <h3>${p.name}</h3>
        <p class="desc">${p.desc}</p>
        <div class="buy">${action}</div>
      </div>
    </article>`;
  }).join("") : `<div class="empty">No encontramos productos con esa búsqueda.</div>`;
}

/* ============ Carrito ============ */
function renderCart() {
  const { lines, n, sub } = totals();
  $("#count").textContent = n;
  $("#barCount").textContent = n;
  $("#barTotal").textContent = money(sub);
  $("#subtotal").textContent = money(sub);
  $("#total").textContent = money(sub);
  $("#cartbar").hidden = n === 0 || $("#overlay").classList.contains("show") || $("#modal").classList.contains("show");

  $("#items").innerHTML = lines.length ? lines.map(({ p, q }) =>
    `<div class="item">
      <span style="font-size:29px" aria-hidden="true">${p.emoji}</span>
      <div><h4>${p.name}</h4><small>${money(p.price)} c/u</small>
        <div class="qty">
          <button type="button" data-act="dec" data-id="${p.id}" aria-label="Quitar uno">−</button>
          <b>${q}</b>
          <button type="button" data-act="inc" data-id="${p.id}" aria-label="Agregar uno">+</button>
        </div></div>
      <b>${money(p.price * q)}</b>
    </div>`).join("") : `<div class="empty">Tu carrito está vacío. 🍟</div>`;

  $("#go").disabled = n === 0;
  updateOrderSummary();
  saveCart();
}

function changeQty(id, d) {
  const next = (cart[id] || 0) + d;
  if (next <= 0) delete cart[id]; else cart[id] = Math.min(next, 99);
  renderCart();
}

/* ============ Paneles ============ */
function openPanel(el) {
  lastFocus = document.activeElement;
  el.classList.add("show");
  el.setAttribute("aria-hidden", "false");
  document.body.style.overflow = "hidden";
  renderCart();
}
function closePanel(el) {
  el.classList.remove("show");
  el.setAttribute("aria-hidden", "true");
  if (!$("#overlay").classList.contains("show") && !$("#modal").classList.contains("show")) document.body.style.overflow = "";
  renderCart();
  if (lastFocus && lastFocus.focus) lastFocus.focus();
}

/* ============ Formulario ============ */
function shippingFor(city) { return CONFIG.ENVIO[city] ?? null; }

function updateOrderSummary() {
  const { sub } = totals();
  const env = shippingFor($("#city").value);
  $("#ordersum").innerHTML =
    `<div class="rowtotal"><span>Subtotal</span><b>${money(sub)}</b></div>
     <div class="rowtotal"><span>Envío</span><span>${env === null ? "Elegí tu zona" : money(env)}</span></div>
     <div class="rowtotal total"><span>Total</span><span>${money(sub + (env || 0))}</span></div>`;
}

function buildWhatsAppText(p, subtotal) {
  const lineas = p.productos.map(x => `• ${x.cantidad} x ${x.nombre}`).join("\n");
  return `Hola! Hice un pedido en El Bajón Deli:\n${lineas}\n\nSubtotal: ${money(subtotal)}\nEnvío: ${money(p.costo_envio)}\nTotal: ${money(p.total)}\n\nNombre: ${p.cliente_nombre}\nLocalidad: ${p.localidad}\nDirección: ${p.direccion}\nPago: ${p.forma_pago}${p.indicaciones ? "\nIndicaciones: " + p.indicaciones : ""}`;
}

let supabaseClient = null;
try {
  if (window.supabase) supabaseClient = window.supabase.createClient(CONFIG.SUPABASE_URL, CONFIG.SUPABASE_KEY);
} catch (e) { console.error("No se pudo iniciar Supabase:", e); }

async function submitOrder(e) {
  e.preventDefault();
  const err = $("#formerror");
  err.textContent = "";

  const { lines, sub } = totals();
  if (!lines.length) { err.textContent = "Tu carrito está vacío."; return; }

  const nombre = $("#name").value.trim();
  const tel = $("#phone").value.trim();
  const localidad = $("#city").value;
  const pago = $("#payment").value;
  const dir = $("#address").value.trim();

  if (!nombre || !tel || !localidad || !pago || !dir) { err.textContent = "Completá todos los campos obligatorios."; return; }
  if (tel.replace(/\D/g, "").length < 8) { err.textContent = "Revisá el teléfono: parece incompleto."; return; }

  const envio = shippingFor(localidad) ?? 0;
  const pedido = {
    cliente_nombre: nombre,
    cliente_telefono: tel,
    localidad,
    direccion: dir,
    forma_pago: pago,
    indicaciones: $("#notes").value.trim(),
    productos: lines.map(({ p, q }) => ({ id: p.id, nombre: p.name, precio: p.price, cantidad: q })),
    costo_envio: envio,
    total: sub + envio,
    estado: "pendiente"
  };

  const btn = $("#submitBtn");
  btn.disabled = true;
  btn.textContent = "Enviando…";

  try {
    if (!supabaseClient) throw new Error("Sin conexión con el servidor de pedidos");
    const { error } = await supabaseClient.from("pedidos").insert(pedido);
    if (error) throw error;

    $("#confTitle").textContent = CONFIG.MODO_DEMO ? "¡Pedido registrado para prueba!" : "¡Pedido recibido!";
    $("#confirmtext").textContent = CONFIG.MODO_DEMO
      ? `¡Gracias, ${nombre}! Tu pedido quedó registrado para prueba.`
      : `¡Gracias, ${nombre}! Te vamos a contactar al ${tel} para confirmar tu pedido.`;
    $("#summary").textContent = `Subtotal: ${money(sub)} · Envío: ${money(envio)} · Total: ${money(pedido.total)} · Estado: pendiente`;
    $("#confNote").textContent = CONFIG.MODO_DEMO ? "Pedido registrado para prueba. No confirma una compra real ni habilita una entrega." : "";

    const waBtn = $("#waBtn");
    if (wa) { waBtn.href = waLink(buildWhatsAppText(pedido, sub)); waBtn.hidden = false; } else { waBtn.hidden = true; }

    $("#formwrap").style.display = "none";
    $("#confirmation").classList.add("show");
    cart = {};
    renderCart();
  } catch (error) {
    console.error("Error al guardar el pedido:", error);
    err.textContent = "No pudimos registrar tu pedido. Probá de nuevo en un momento" + (wa ? " o escribinos por WhatsApp." : ".");
  } finally {
    btn.disabled = false;
    btn.textContent = "Confirmar pedido";
  }
}

function resetAfterOrder() {
  closePanel($("#modal"));
  $("#formwrap").style.display = "";
  $("#confirmation").classList.remove("show");
  $("#form").reset();
  $("#transferInfo").hidden = true;
  $("#formerror").textContent = "";
  $("#search").value = "";
  selected = "Todo";
  renderFilters(); renderProducts(); renderCart();
}

/* ============ Efecto 3D (solo mouse, no en pantallas táctiles) ============ */
function attachTilt(root, sel, max) {
  if (!root) return;
  if (!matchMedia("(hover:hover) and (pointer:fine)").matches) return;
  if (matchMedia("(prefers-reduced-motion:reduce)").matches) return;
  let cur = null;
  const reset = el => {
    if (!el) return;
    ["--rx", "--ry"].forEach(k => el.style.setProperty(k, "0deg"));
    ["--px", "--py"].forEach(k => el.style.setProperty(k, "0"));
    el.classList.remove("tilting");
  };
  root.addEventListener("pointermove", e => {
    const el = e.target.closest(sel);
    if (el !== cur) { reset(cur); cur = el; }
    if (!el) return;
    const r = el.getBoundingClientRect();
    const x = (e.clientX - r.left) / r.width, y = (e.clientY - r.top) / r.height;
    el.style.setProperty("--ry", ((x - .5) * 2 * max).toFixed(2) + "deg");
    el.style.setProperty("--rx", ((.5 - y) * 2 * max).toFixed(2) + "deg");
    el.style.setProperty("--px", ((x - .5) * 2).toFixed(2));
    el.style.setProperty("--py", ((y - .5) * 2).toFixed(2));
    el.style.setProperty("--gx", (x * 100).toFixed(0) + "%");
    el.style.setProperty("--gy", (y * 100).toFixed(0) + "%");
    el.classList.add("tilting");
  });
  root.addEventListener("pointerleave", () => { reset(cur); cur = null; });
}

/* ============ Arranque ============ */
function init() {
  // Textos que dependen del modo
  $("#demoNotice").hidden = !CONFIG.MODO_DEMO;
  $("#drawNote").textContent = CONFIG.MODO_DEMO ? "Demo: no se cobra ni se entrega ningún pedido." : "El costo de envío se calcula según tu zona en el paso siguiente.";
  $("#formNote").textContent = CONFIG.MODO_DEMO
    ? "Completá para probar el flujo de compra. El pedido se registra solo a modo de prueba."
    : "Completá tus datos para que podamos llevarte el pedido.";
  $("#formNotice").textContent = CONFIG.MODO_DEMO
    ? "No ingreses datos de tarjetas. Esta demo no procesa pagos; tus datos de contacto se registran únicamente para la prueba."
    : "No ingreses datos de tarjetas. El pago es en efectivo o por transferencia.";

  // Envíos
  const vals = Object.values(CONFIG.ENVIO);
  const min = Math.min(...vals), max = Math.max(...vals);
  $("#infoEnvio").textContent = min === max ? `Envío ${money(min)}` : `Envío desde ${money(min)} según zona`;
  $("#envioRango").textContent = min === max ? money(min) : `${money(min)} – ${money(max)}`;
  $("#city").innerHTML = `<option value="">Elegí tu zona</option>` +
    Object.entries(CONFIG.ENVIO).map(([c, v]) => `<option value="${c}">${c} (${money(v)})</option>`).join("");
  $("#aliasTxt").textContent = CONFIG.ALIAS;
  $("#titularTxt").textContent = CONFIG.TITULAR;

  // Eventos
  $("#seeProducts").onclick = () => $("#catalogo").scrollIntoView({ behavior: "smooth" });
  $("#search").oninput = renderProducts;
  $("#filters").onclick = e => {
    const b = e.target.closest("[data-cat]"); if (!b) return;
    selected = b.dataset.cat; renderFilters(); renderProducts();
  };
  $("#products").onclick = e => {
    const b = e.target.closest("[data-add]"); if (!b) return;
    const p = byId(b.dataset.add);
    cart[p.id] = Math.min((cart[p.id] || 0) + 1, 99);
    renderCart(); toast("Agregado: " + p.name);
  };
  $("#items").onclick = e => {
    const b = e.target.closest("[data-act]"); if (!b) return;
    changeQty(b.dataset.id, b.dataset.act === "inc" ? 1 : -1);
  };

  const overlay = $("#overlay"), modal = $("#modal");
  $("#open").onclick = () => openPanel(overlay);
  $("#cartbar").onclick = () => openPanel(overlay);
  $("#close").onclick = () => closePanel(overlay);
  overlay.onclick = e => { if (e.target === overlay) closePanel(overlay); };
  $("#go").onclick = () => {
    if (!Object.keys(cart).length) return;
    overlay.classList.remove("show"); overlay.setAttribute("aria-hidden", "true");
    openPanel(modal);
    setTimeout(() => $("#name").focus(), 50);
  };
  $("#closemodal").onclick = () => closePanel(modal);
  modal.onclick = e => { if (e.target === modal && !$("#confirmation").classList.contains("show")) closePanel(modal); };
  document.addEventListener("keydown", e => {
    if (e.key !== "Escape") return;
    if (modal.classList.contains("show") && !$("#confirmation").classList.contains("show")) closePanel(modal);
    else if (overlay.classList.contains("show")) closePanel(overlay);
  });

  $("#city").onchange = updateOrderSummary;
  $("#payment").onchange = e => { $("#transferInfo").hidden = e.target.value !== "Transferencia"; };
  $("#copyAlias").onclick = async () => {
    try { await navigator.clipboard.writeText(CONFIG.ALIAS); toast("Alias copiado"); }
    catch (e) { toast("Alias: " + CONFIG.ALIAS); }
  };
  $("#form").onsubmit = submitOrder;
  $("#finish").onclick = resetAfterOrder;

  renderFilters(); renderProducts(); renderCart();
  attachTilt($("#products"), ".product", 9);
  attachTilt($(".hero"), ".hero>div", 4);
}
init();
</script>
</body>
</html>
